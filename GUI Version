# -------------------- AUTOMATION ---------------------------

$script:running = $false

$script:btnRun.Add_Click({

    if ($script:running) {
        return
    }

    $employeeID = $script:txtEmployeeID.Text.Trim()
    $fullName = $script:txtFullName.Text.Trim()

    if ([string]::IsNullOrWhiteSpace($employeeID) -or
        [string]::IsNullOrWhiteSpace($fullName)) {

        [System.Windows.Forms.MessageBox]::Show(
            "Enter both the Employee ID and full name.",
            "Missing information",
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Warning
        ) | Out-Null

        return
    }

    $parsedGalaxyID = 0
    $parsedDownKeys = 0

    if (-not [int]::TryParse($script:txtGalaxyID.Text, [ref]$parsedGalaxyID) -or
        -not [int]::TryParse($script:txtDownKeys.Text, [ref]$parsedDownKeys) -or
        $parsedDownKeys -lt 0) {

        [System.Windows.Forms.MessageBox]::Show(
            "Galaxy ID must be an integer and Down Key Presses must be a non-negative integer.",
            "Invalid settings",
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Warning
        ) | Out-Null

        return
    }

    $usernameX = 0
    $usernameY = 0

    if ($script:chkUseMouse.Checked) {

        if (-not [int]::TryParse($script:txtUsernameX.Text, [ref]$usernameX) -or
            -not [int]::TryParse($script:txtUsernameY.Text, [ref]$usernameY)) {

            [System.Windows.Forms.MessageBox]::Show(
                "Enter valid integer values for the username coordinates.",
                "Invalid coordinates",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Warning
            ) | Out-Null

            return
        }
    }

    # Validate expiration date.

    if ($script:chkExpiration.Checked) {

        $month = 0
        $day = 0
        $year = 0

        if (-not [int]::TryParse($script:txtMonth.Text, [ref]$month) -or
            -not [int]::TryParse($script:txtDay.Text, [ref]$day) -or
            -not [int]::TryParse($script:txtYear.Text, [ref]$year) -or
            $month -lt 1 -or $month -gt 12 -or
            $day -lt 1 -or $day -gt 31) {

            [System.Windows.Forms.MessageBox]::Show(
                "Enter a valid expiration month, day, and year.",
                "Invalid expiration date",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Warning
            ) | Out-Null

            return
        }

        # Interpret a two-digit year as 2000-2099 for validation.
        $fullYear = if ($year -lt 100) { 2000 + $year } else { $year }

        try {
            [void](Get-Date -Year $fullYear -Month $month -Day $day)
        }
        catch {
            [System.Windows.Forms.MessageBox]::Show(
                "That expiration date does not exist.",
                "Invalid expiration date",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Warning
            ) | Out-Null

            return
        }
    }

    $script:currentAccountNum = $parsedGalaxyID
    $script:downKeyCount = $parsedDownKeys
    $script:nickname = $script:txtNickname.Text

    if ([string]::IsNullOrWhiteSpace($script:nickname)) {
        $script:nickname = "fb*"
    }

    $script:checkIfExistsMode = $script:chkCheckExists.Checked
    $script:expireAccount = $script:chkExpiration.Checked
    $script:expireMonth = $script:txtMonth.Text
    $script:expireDay = $script:txtDay.Text
    $script:expireYear = $script:txtYear.Text
    $script:useMouseCoordinates = $script:chkUseMouse.Checked

    $script:usernameX = $usernameX
    $script:usernameY = $usernameY

    $script:running = $true
    $script:btnRun.Enabled = $false

    try {

        $wshell = New-Object -ComObject WScript.Shell

if ($script:useMouseCoordinates) {
    $script:lblStatus.Text = "Switching to Galaxy. Starting in 0.5 seconds..."
    Invoke-ResponsiveDelay 500
}
else {
    $script:lblStatus.Text = "Switching to Galaxy. Starting in 2 seconds..."
    Invoke-ResponsiveDelay 2000
}

        if ($script:useMouseCoordinates) {

            $script:lblStatus.Text = "Selecting username field..."

            Invoke-GalaxyClick -X $script:usernameX -Y $script:usernameY

            Invoke-ResponsiveDelay 250
        }

        $accountExists = "N"

        # ---------------- EXISTING ACCOUNT CHECK ------------

        if ($script:checkIfExistsMode) {

$wshell.SendKeys($employeeID)

if ($script:useMouseCoordinates) {
    Invoke-ResponsiveDelay 200
}
else {
    Invoke-ResponsiveDelay 2000
}

$wshell.SendKeys("{ENTER}")

if ($script:useMouseCoordinates) {
    Invoke-ResponsiveDelay 500
}
else {
    Invoke-ResponsiveDelay 2000
}

            $checkMsg = [System.Windows.Forms.MessageBox]::Show(
                "Does the intended account exist in Galaxy? Select Yes only after verifying the displayed account.",
                "Galaxy Account Check",
                [System.Windows.Forms.MessageBoxButtons]::YesNo,
                [System.Windows.Forms.MessageBoxIcon]::Question
            )

            if ($checkMsg -eq [System.Windows.Forms.DialogResult]::Yes) {
                $accountExists = "Y"
            }
        }

        # -------- EXISTING ACCOUNT / PASSWORD RESET --------

        if ($script:checkIfExistsMode -and
            ($accountExists -match "^[Yy]")) {

            $script:lblStatus.Text = "Password reset workflow running..."

            Invoke-ResponsiveDelay 500

            $wshell.SendKeys("{ENTER}")
            Invoke-ResponsiveDelay 200

            for ($i = 1; $i -le 3; $i++) {
                $wshell.SendKeys("{TAB}")
            }

            Invoke-ResponsiveDelay 200

            $wshell.SendKeys("{DOWN}")
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys("{TAB}")
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys("{ }")
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys("{TAB}")
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys($script:resetPassword)
            Invoke-ResponsiveDelay 200

            for ($i = 1; $i -le 18; $i++) {
                $wshell.SendKeys("{TAB}")
            }

            Invoke-ResponsiveDelay 50

            $script:currentAccountNum--
        }

        # -------- STANDARD ACCOUNT CREATION -----------------

        else {

            $script:lblStatus.Text = "Creating account..."

            if ($script:checkIfExistsMode) {
                Invoke-ResponsiveDelay 500
            }

            $wshell.SendKeys("%n")
            Invoke-ResponsiveDelay 400

            $wshell.SendKeys($employeeID)
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys("{TAB}{ENTER}")
            Invoke-ResponsiveDelay 500

            for ($i = 1; $i -le $script:downKeyCount; $i++) {
                $wshell.SendKeys("{DOWN}")
                Invoke-ResponsiveDelay 50
            }

            $wshell.SendKeys("{ENTER}")
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys("{TAB}")
            $wshell.SendKeys([string]$script:currentAccountNum)
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys("{TAB}{TAB}")
            $wshell.SendKeys($fullName)
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys("{TAB}")
            $wshell.SendKeys($script:nickname)
            Invoke-ResponsiveDelay 200

            for ($i = 1; $i -le 7; $i++) {
                $wshell.SendKeys("{TAB}")
            }

            $wshell.SendKeys("{ENTER}")
            Invoke-ResponsiveDelay 600

            for ($i = 1; $i -le 12; $i++) {
                $wshell.SendKeys("{TAB}")
            }

            $wshell.SendKeys("{DOWN}{TAB}")
            Invoke-ResponsiveDelay 200

            $wshell.SendKeys($script:defaultPassword)
            Invoke-ResponsiveDelay 200
        }

        # -------- EXPIRATION FIELD MAPPING -----------------

        if (!$script:checkIfExistsMode -or
            $accountExists -notmatch "^[Yy]") {

            for ($i = 1; $i -le 5; $i++) {
                $wshell.SendKeys("{TAB}")
            }

            Invoke-ResponsiveDelay 200

            if ($script:expireAccount) {

                $wshell.SendKeys("{ }")
                $wshell.SendKeys("{TAB}")
                Invoke-ResponsiveDelay 30

                if (![string]::IsNullOrWhiteSpace($script:expireMonth)) {
                    $wshell.SendKeys($script:expireMonth)
                }

                Invoke-ResponsiveDelay 30

                $wshell.SendKeys("{RIGHT}")
                Invoke-ResponsiveDelay 30

                if (![string]::IsNullOrWhiteSpace($script:expireDay)) {
                    $wshell.SendKeys($script:expireDay)
                }

                Invoke-ResponsiveDelay 30

                $wshell.SendKeys("{RIGHT}")
                Invoke-ResponsiveDelay 30

                if (![string]::IsNullOrWhiteSpace($script:expireYear)) {
                    $wshell.SendKeys($script:expireYear)
                }
		$wshell.SendKeys("{TAB}")
		$wshell.SendKeys("{TAB}")
		$wshell.SendKeys($script:loginsAfterExpire)

                Invoke-ResponsiveDelay 30

                for ($i = 1; $i -le 12; $i++) {
                    $wshell.SendKeys("{TAB}")
                }
            }
        }

        $script:currentAccountNum++

        $script:txtGalaxyID.Text = [string]$script:currentAccountNum

        if ($script:checkIfExistsMode -and
            ($accountExists -match "^[Yy]")) {

            $script:lblStatus.Text = "Reset sequence completed. Review Galaxy."
        }
        else {
            $script:lblStatus.Text = "Creation sequence completed. Verify the account in Galaxy."
        }

        $script:txtEmployeeID.Clear()
        $script:txtFullName.Clear()
    }

    catch {

        $script:lblStatus.Text = "Automation error. Check Galaxy before retrying."

        [System.Windows.Forms.MessageBox]::Show(
            "An error interrupted the automation:`r`n$($_.Exception.Message)`r`n`r`nCheck Galaxy before retrying to avoid duplicate actions.",
            "Automation Error",
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Error
        ) | Out-Null
    }

    finally {

        $script:running = $false
        $script:btnRun.Enabled = $true
    }
})

