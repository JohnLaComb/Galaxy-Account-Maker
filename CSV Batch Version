# -------------------- EVENT LOGIC ---------------------------

# Browse CSV
$script:btnBrowse.Add_Click({
    $ofd = New-Object System.Windows.Forms.OpenFileDialog
    $ofd.Filter = "CSV Files (*.csv)|*.csv|All Files (*.*)|*.*"
    $ofd.Title = "Select Employee Import CSV"

    if ($ofd.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $script:txtCsvPath.Text = $ofd.FileName
        try {
            $rawRecords = Import-Csv -Path $ofd.FileName
            if ($rawRecords.Count -eq 0) {
                [System.Windows.Forms.MessageBox]::Show("The selected CSV contains no records.", "Empty File") | Out-Null
                return
            }

            # Check mandatory columns
            $properties = $rawRecords[0].PSObject.Properties.Name
            if (-not ($properties -contains "EmployeeID" -and $properties -contains "FullName")) {
                [System.Windows.Forms.MessageBox]::Show(
                    "CSV must contain 'EmployeeID' and 'FullName' headers.`r`nOptional headers: Nickname, PrivilegeDownKeys, ExpirationDate",
                    "Invalid CSV Format",
                    [System.Windows.Forms.MessageBoxButtons]::OK,
                    [System.Windows.Forms.MessageBoxIcon]::Error
                ) | Out-Null
                return
            }

            $script:csvRecords = $rawRecords
            $script:grid.Rows.Clear()

            for ($i = 0; $i -lt $rawRecords.Count; $i++) {
                $row = $rawRecords[$i]
                [void]$script:grid.Rows.Add(
                    ($i + 1),
                    $row.EmployeeID,
                    $row.FullName,
                    "---",
                    "Pending"
                )
            }

            $script:lblCsvStatus.Text = "Loaded $($rawRecords.Count) rows ready to provision."
            $script:lblBatchStatus.Text = "Loaded $($rawRecords.Count) rows. Verify starting ID and click Start."
            $script:btnStart.Enabled = $true
            $script:progressBar.Maximum = $rawRecords.Count
            $script:progressBar.Value = 0
        }
        catch {
            [System.Windows.Forms.MessageBox]::Show("Error reading CSV: $($_.Exception.Message)", "File Error") | Out-Null
        }
    }
})

