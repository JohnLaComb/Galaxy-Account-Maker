function New-BatchLabel {
    param([string]$Text, [int]$X, [int]$Y, [int]$Width = 200, [int]$Height = 20, [int]$FontSize = 9, $Color = [System.Drawing.Color]::FromArgb(30,41,59))
    $lbl = New-Object System.Windows.Forms.Label
    $lbl.Text = $Text
    $lbl.Location = New-Object System.Drawing.Point($X, $Y)
    $lbl.Size = New-Object System.Drawing.Size($Width, $Height)
    $lbl.Font = New-Object System.Drawing.Font("Segoe UI", $FontSize)
    $lbl.ForeColor = $Color
    return $lbl
}

function New-BatchTextBox {
    param([string]$Text, [int]$X, [int]$Y, [int]$Width = 100)
    $txt = New-Object System.Windows.Forms.TextBox
    $txt.Text = $Text
    $txt.Location = New-Object System.Drawing.Point($X, $Y)
    $txt.Size = New-Object System.Drawing.Size($Width, 25)
    $txt.Font = New-Object System.Drawing.Font("Segoe UI", 9)
    return $txt
}

function New-BatchButton {
    param([string]$Text, [int]$X, [int]$Y, [int]$Width = 80, [int]$Height = 27)
    $btn = New-Object System.Windows.Forms.Button
    $btn.Text = $Text
    $btn.Location = New-Object System.Drawing.Point($X, $Y)
    $btn.Size = New-Object System.Drawing.Size($Width, $Height)
    $btn.Font = New-Object System.Drawing.Font("Segoe UI", 8)
    $btn.FlatStyle = "Flat"
    return $btn
}

function Invoke-PacedDelay {
    param([int]$BaseMilliseconds, [double]$PacingMultiplier)
    $totalWait = [int]($BaseMilliseconds * $PacingMultiplier)
    $timer = [System.Diagnostics.Stopwatch]::StartNew()
    while ($timer.ElapsedMilliseconds -lt $totalWait) {
        if ([GalaxyBatchMouse]::IsEscapePressed()) {
            throw "Batch halted by user (Escape key pressed)."
        }
        [System.Windows.Forms.Application]::DoEvents()
        Start-Sleep -Milliseconds 10
    }
}

