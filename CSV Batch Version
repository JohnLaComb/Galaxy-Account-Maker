# -------------------- AUTOMATION ENGINE ---------------------

$script:btnStart.Add_Click({
    if ($script:isRunning) { return }

    # Parse Starting Values
    $startGalaxyID = 0
    $startRow = 0
    $defDownKeys = 0

    if (-not [int]::TryParse($script:txtStartID.Text, [ref]$startGalaxyID) -or
        -not [int]::TryParse($script:txtStartRow.Text, [ref]$startRow) -or
        -not [int]::TryParse($script:txtDefDownKeys.Text, [ref]$defDownKeys)) {
        [System.Windows.Forms.MessageBox]::Show("Galaxy ID, Start Row, and Default Down Keys must be valid numbers.", "Validation Error") | Out-Null
        return
    }

    if ($startRow -lt 1 -or $startRow -gt $script:csvRecords.Count) {
        [System.Windows.Forms.MessageBox]::Show("Start Row must be between 1 and $($script:csvRecords.Count).", "Invalid Row") | Out-Null
        return
    }

    $mouseX = 0; $mouseY = 0
    if ($script:chkAutoMouse.Checked) {
        if (-not [int]::TryParse($script:txtMouseX.Text, [ref]$mouseX) -or -not [int]::TryParse($script:txtMouseY.Text, [ref]$mouseY)) {
            [System.Windows.Forms.MessageBox]::Show("Coordinates must be valid numbers.", "Coordinate Error") | Out-Null
            return
        }
    }

    # Pacing Multipliers
    $pacingMultiplier = 1.6
    switch ($script:cboPacing.SelectedIndex) {
        1 { $pacingMultiplier = 1.0 }
        2 { $pacingMultiplier = 0.6 }
    }

    $script:isRunning = $true
    $script:isPaused = $false
    $script:btnStart.Enabled = $false
    $script:btnPause.Enabled = $true
    $script:btnBrowse.Enabled = $false

    $currentAccountNum = $startGalaxyID
    $startIndex = $startRow - 1

    try {
        $wshell = New-Object -ComObject WScript.Shell

        # Initial countdown to focus Galaxy
        for ($c = 3; $c -ge 1; $c--) {
            $script:lblBatchStatus.Text = "Focusing Galaxy in $c seconds... (Press ESC to cancel)"
            Invoke-PacedDelay 1000 1.0
        }

        for ($i = $startIndex; $i -lt $script:csvRecords.Count; $i++) {

            if ($script:isPaused) {
                $script:txtStartRow.Text = [string]($i + 1)
                $script:txtStartID.Text = [string]$currentAccountNum
                $script:lblBatchStatus.Text = "PAUSED at Row $($i + 1). Click Resume to continue."
                break
            }

            $rec = $script:csvRecords[$i]
            $gridRow = $script:grid.Rows[$i]
            $script:grid.ClearSelection()
            $gridRow.Selected = $true
            $gridRow.Cells["Status"].Value = "In Progress..."
            $gridRow.DefaultCellStyle.BackColor = [System.Drawing.Color]::LemonChiffon

            $script:progressBar.Value = $i + 1
            $script:lblBatchStatus.Text = "Processing Row $($i + 1) of $($script:csvRecords.Count): $($rec.FullName)"

            # Resolve per-row overrides or fallbacks
            $empID    = $rec.EmployeeID.Trim()
            $fullName = $rec.FullName.Trim()

            $nickname = if ($rec.PSObject.Properties.Name -contains "Nickname" -and -not [string]::IsNullOrWhiteSpace($rec.Nickname)) {
                $rec.Nickname.Trim()
            } else {
                $script:txtDefNickname.Text
            }
            if ([string]::IsNullOrWhiteSpace($nickname)) { $nickname = "NickName" }

            $downKeys = $defDownKeys
            if ($rec.PSObject.Properties.Name -contains "PrivilegeDownKeys" -and -not [string]::IsNullOrWhiteSpace($rec.PrivilegeDownKeys)) {
                [int]::TryParse($rec.PrivilegeDownKeys, [ref]$downKeys) | Out-Null
            }

            # 1. Bring Galaxy to foreground and click Username
            $null = $wshell.AppActivate("Galaxy")
            Invoke-PacedDelay 300 $pacingMultiplier

            if ($script:chkAutoMouse.Checked) {
                [GalaxyBatchMouse]::Click($mouseX, $mouseY)
                Invoke-PacedDelay 250 $pacingMultiplier
            }

            # 2. Open New Account Modal: Alt+N
            $wshell.SendKeys("%n")
            Invoke-PacedDelay 450 $pacingMultiplier

            # 3. Employee ID
            $wshell.SendKeys($empID)
            Invoke-PacedDelay 200 $pacingMultiplier

            # 4. Advance to Privilege dropdown
            $wshell.SendKeys("{TAB}{ENTER}")
            Invoke-PacedDelay 450 $pacingMultiplier

            # 5. Down-arrow selections
            for ($k = 1; $k -le $downKeys; $k++) {
                $wshell.SendKeys("{DOWN}")
                Invoke-PacedDelay 50 $pacingMultiplier
            }
            $wshell.SendKeys("{ENTER}")
            Invoke-PacedDelay 200 $pacingMultiplier

            # 6. Galaxy Account Number
            $wshell.SendKeys("{TAB}")
            $wshell.SendKeys([string]$currentAccountNum)
            Invoke-PacedDelay 200 $pacingMultiplier

            # 7. Full Name
            $wshell.SendKeys("{TAB}{TAB}")
            $wshell.SendKeys($fullName)
            Invoke-PacedDelay 200 $pacingMultiplier

            # 8. Nickname
            $wshell.SendKeys("{TAB}")
            $wshell.SendKeys($nickname)
            Invoke-PacedDelay 200 $pacingMultiplier

            # 9. Advance to second page
            for ($k = 1; $k -le 7; $k++) { $wshell.SendKeys("{TAB}") }
            $wshell.SendKeys("{ENTER}")
            Invoke-PacedDelay 600 $pacingMultiplier

            # 10. Password fields
            for ($k = 1; $k -le 12; $k++) { $wshell.SendKeys("{TAB}") }
            $wshell.SendKeys("{DOWN}{TAB}")
            Invoke-PacedDelay 200 $pacingMultiplier

            $wshell.SendKeys($script:defaultPassword)
            Invoke-PacedDelay 200 $pacingMultiplier

            # 11. Expiration Settings
            for ($k = 1; $k -le 5; $k++) { $wshell.SendKeys("{TAB}") }
            Invoke-PacedDelay 200 $pacingMultiplier

            if ($script:chkExpiration.Checked) {
                $rowDate = $script:dtpExpire.Value
                if ($rec.PSObject.Properties.Name -contains "ExpirationDate" -and -not [string]::IsNullOrWhiteSpace($rec.ExpirationDate)) {
                    $parsedDate = Get-Date
                    if ([DateTime]::TryParse($rec.ExpirationDate, [ref]$parsedDate)) {
                        $rowDate = $parsedDate
                    }
                }

                $expM = $rowDate.ToString("MM")
                $expD = $rowDate.ToString("dd")
                $expY = $rowDate.ToString("yy")

                $wshell.SendKeys("{ }")
                $wshell.SendKeys("{TAB}")
                Invoke-PacedDelay 40 $pacingMultiplier

                $expM = $rowDate.ToString("MM")
                Invoke-PacedDelay 40 $pacingMultiplier
                $wshell.SendKeys($expM)
                Invoke-PacedDelay 40 $pacingMultiplier
                $wshell.SendKeys("{RIGHT}")
                Invoke-PacedDelay 40 $pacingMultiplier
                $wshell.SendKeys($expD)
                Invoke-PacedDelay 40 $pacingMultiplier
                $wshell.SendKeys("{RIGHT}")
                Invoke-PacedDelay 40 $pacingMultiplier
                $wshell.SendKeys($expY)
                Invoke-PacedDelay 40 $pacingMultiplier

                $wshell.SendKeys("{TAB}{TAB}")
                $wshell.SendKeys($script:loginsAfterExpire)
                Invoke-PacedDelay 40 $pacingMultiplier

                for ($k = 1; $k -le 12; $k++) { $wshell.SendKeys("{TAB}") }
            }

            # 12. Commit / Save record
            $wshell.SendKeys("{ENTER}")

            # Database write cooldown (crucial for batch desync prevention)
            Invoke-PacedDelay 1800 $pacingMultiplier

            # Mark row completed
            $gridRow.Cells["GalaxyID"].Value = [string]$currentAccountNum
            $gridRow.Cells["Status"].Value = "Created"
            $gridRow.DefaultCellStyle.BackColor = [System.Drawing.Color]::Honeydew

            $currentAccountNum++
            $script:txtStartID.Text = [string]$currentAccountNum
            $script:txtStartRow.Text = [string]($i + 2)
        }

        if (-not $script:isPaused) {
            $script:lblBatchStatus.Text = "Batch Completed! All accounts provisioned."
            [System.Windows.Forms.MessageBox]::Show(
                "Batch processing complete! All accounts have been provisioned.",
                "Batch Complete",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Information
            ) | Out-Null
        }
    }
    catch {
        $script:lblBatchStatus.Text = "Batch Halted: $($_.Exception.Message)"
        if ($i -lt $script:csvRecords.Count) {
            $script:grid.Rows[$i].Cells["Status"].Value = "Halted"
            $script:grid.Rows[$i].DefaultCellStyle.BackColor = [System.Drawing.Color]::MistyRose
            $script:txtStartRow.Text = [string]($i + 1)
            $script:txtStartID.Text = [string]$currentAccountNum
        }

        [System.Windows.Forms.MessageBox]::Show(
            "Batch execution stopped:`r`n$($_.Exception.Message)`r`n`r`nVerify Galaxy state before resuming from Row $($script:txtStartRow.Text).",
            "Batch Halted",
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Warning
        ) | Out-Null
    }
    finally {
        $script:isRunning = $false
        $script:btnStart.Enabled = $true
        $script:btnStart.Text = if ($script:isPaused) { "RESUME BATCH" } else { "START BATCH AUTOMATION" }
        $script:btnPause.Enabled = $false
        $script:btnBrowse.Enabled = $true
    }
})

