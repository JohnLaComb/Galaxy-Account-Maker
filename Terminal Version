# --- 1. STARTUP CONFIGURATION ---
Add-Type -AssemblyName Microsoft.VisualBasic
Add-Type -AssemblyName System.Windows.Forms

Write-Host "--- GALAXY ACCELERATED CREATOR ---" -ForegroundColor Cyan

# 1. Starting Galaxy ID
$inputID = [Microsoft.VisualBasic.Interaction]::InputBox("What is the starting Galaxy Account Number for today?", "Galaxy Setup", "1")
if ([string]::IsNullOrWhiteSpace($inputID)) { $inputID = "1" }
$currentAccountNum = [int]$inputID

# 2. Check if Account Exists Mode
$checkMsg = [System.Windows.Forms.MessageBox]::Show("Enable 'Check if Account Exists / Password Reset' feature?", "Galaxy Mode Selection", [System.Windows.Forms.MessageBoxButtons]::YesNo, [System.Windows.Forms.MessageBoxIcon]::Question)
$checkIfExistsMode = ($checkMsg -eq [System.Windows.Forms.DialogResult]::Yes)
$checkStatusText = if ($checkIfExistsMode) { "ENABLED" } else { "DISABLED" }
Write-Host "Check Feature: $checkStatusText" -ForegroundColor Cyan

# Default script settings
$nickname = "NickName"
$downKeyCount = 1
$defaultPassword = "NormalPassword11!"
$resetPassword = "ResetPassword11!"
$loginsAfterExpire = "1"

# Expiration Date Settings
$expireAccount = $true
$expireMonth = "12"
$expireDay = "31"
$expireYear = "26"

# --- 2. MAIN AUTOMATION LOOP ---
while ($true) {
    Write-Host "`nNext Galaxy ID: $currentAccountNum" -ForegroundColor Yellow
    Write-Host "Type 'CHANGE' at Employee ID to update settings, or 'EXIT' to quit." -ForegroundColor DarkGray
    $employeeID = Read-Host "Enter Employee ID"

    if ($employeeID -eq "EXIT") { break }

    # --- CHANGE SETTINGS ---
    if ($employeeID -eq "CHANGE") {
        Write-Host "`nCHANGE SETTINGS" -ForegroundColor Cyan
        Write-Host "1 - Nickname ($nickname)"
        Write-Host "2 - Galaxy ID ($currentAccountNum)"
        Write-Host "3 - Down Key Count ($downKeyCount)"
        Write-Host "4 - Toggle 'Check If Account Exists' ($checkIfExistsMode)"
        Write-Host "0 - Change Everything"
        
        $choice = Read-Host "`nSelection"
        switch ($choice) {
            "1" {
                $nickname = Read-Host "Enter NEW Nickname"
                if ([string]::IsNullOrWhiteSpace($nickname)) { $nickname = "NickName" }
            }
            "2" {
                $currentAccountNum = [int](Read-Host "Enter NEW Galaxy ID")
            }
            "3" {
                $downKeyCount = [int](Read-Host "Enter NEW DOWN Key Count")
            }
            "4" {
                $toggleCheck = Read-Host "Enable 'Check if Account Exists' feature? (Y/N)"
                $checkIfExistsMode = ($toggleCheck -match "^[Yy]")
            }
            "0" {
                $nickname = Read-Host "Enter NEW Nickname"
                if ([string]::IsNullOrWhiteSpace($nickname)) { $nickname = "NickName" }
                $currentAccountNum = [int](Read-Host "Enter NEW Galaxy ID")
                $downKeyCount = [int](Read-Host "Enter NEW DOWN Key Count")
                $toggleCheck = Read-Host "Enable 'Check if Account Exists' feature? (Y/N)"
                $checkIfExistsMode = ($toggleCheck -match "^[Yy]")
            }
            default {
                Write-Host "Invalid selection." -ForegroundColor Red
                Start-Sleep -Seconds 1
            }
        }
        continue
    }

    $fullName = Read-Host "Enter First and Last Name"
    Write-Host "`nClick onto USERNAME in Galaxy window now... (3 second timer)" -ForegroundColor Yellow
    Start-Sleep -Seconds 3

    $wshell = New-Object -ComObject Wscript.Shell
    $accountExists = "N"

    if ($checkIfExistsMode) {
        $wshell.SendKeys($employeeID)
        Start-Sleep -Milliseconds 200
        $wshell.SendKeys("{ENTER}")
        Write-Host ""
        $accountExists = Read-Host "Does this account already exist? (Y/N)"
    }

    # Password reset workflow
    if ($checkIfExistsMode -and ($accountExists -match "^[Yy]")) {
        Write-Host "Resuming Password Reset sequence... CLICK ON ACCOUNT (2s)" -ForegroundColor Yellow
        Start-Sleep -Seconds 2
        $wshell.SendKeys("{ENTER}")
        Start-Sleep -Milliseconds 200
        for ($i = 1; $i -le 3; $i++) { $wshell.SendKeys("{TAB}") }
        Start-Sleep -Milliseconds 200
        $wshell.SendKeys("{DOWN}")
        Start-Sleep -Milliseconds 200
        $wshell.SendKeys("{TAB}")
        Start-Sleep -Milliseconds 200
        $wshell.SendKeys("{ }")
        Start-Sleep -Milliseconds 200
        $wshell.SendKeys("{TAB}")
        Start-Sleep -Milliseconds 200
        $wshell.SendKeys($resetPassword)
        Start-Sleep -Milliseconds 200
        for ($i = 1; $i -le 18; $i++) { $wshell.SendKeys("{TAB}") }
        Start-Sleep -Milliseconds 50
        $currentAccountNum--
    } 
    # Account creation workflow
    else {
        if ($checkIfExistsMode) {
            Write-Host "Resuming standard creation flow... click back into Galaxy if needed (2s)" -ForegroundColor Yellow
            Start-Sleep -Seconds 2
        }
        $wshell.SendKeys("%n")
        Start-Sleep -Milliseconds 400
        $wshell.SendKeys($employeeID)
        Start-Sleep -Milliseconds 200
        $wshell.SendKeys("{TAB}{ENTER}")
        Start-Sleep -Milliseconds 500

        for ($i = 1; $i -le $downKeyCount; $i++) {
            $wshell.SendKeys("{DOWN}")
            Start-Sleep -Milliseconds 50
        }
        $wshell.SendKeys("{ENTER}")
        Start-Sleep -Milliseconds 200

        $wshell.SendKeys("{TAB}")
        $wshell.SendKeys($currentAccountNum)
        Start-Sleep -Milliseconds 200

        $wshell.SendKeys("{TAB}{TAB}")
        $wshell.SendKeys($fullName)
        Start-Sleep -Milliseconds 200

        $wshell.SendKeys("{TAB}")
        $wshell.SendKeys($nickname)
        Start-Sleep -Milliseconds 200

        for ($i = 1; $i -le 7; $i++) { $wshell.SendKeys("{TAB}") }
        $wshell.SendKeys("{ENTER}")
        Start-Sleep -Milliseconds 600

        for ($i = 1; $i -le 12; $i++) { $wshell.SendKeys("{TAB}") }
        $wshell.SendKeys("{DOWN}{TAB}")
        Start-Sleep -Milliseconds 200

        $wshell.SendKeys($defaultPassword)
        Start-Sleep -Milliseconds 200
    }

    # Expiration field mapping
    if (!$checkIfExistsMode -or $accountExists -notmatch "^[Yy]") {
        for ($i = 1; $i -le 5; $i++) { $wshell.SendKeys("{TAB}") }
        Start-Sleep -Milliseconds 200

        if ($expireAccount) {
            $wshell.SendKeys("{ }")
            $wshell.SendKeys("{TAB}")
            Start-Sleep -Milliseconds 30

            if (![string]::IsNullOrWhiteSpace($expireMonth)) { $wshell.SendKeys($expireMonth) }
            Start-Sleep -Milliseconds 30

            $wshell.SendKeys("{RIGHT}")
            Start-Sleep -Milliseconds 30

            if (![string]::IsNullOrWhiteSpace($expireDay)) { $wshell.SendKeys($expireDay) }
            Start-Sleep -Milliseconds 30

            $wshell.SendKeys("{RIGHT}")
            Start-Sleep -Milliseconds 30

            if (![string]::IsNullOrWhiteSpace($expireYear)) { $wshell.SendKeys($expireYear) }
            Start-Sleep -Milliseconds 30

            $wshell.SendKeys("{TAB}{TAB}")
            $wshell.SendKeys($loginsAfterExpire)
            Start-Sleep -Milliseconds 30

            for ($i = 1; $i -le 12; $i++) { $wshell.SendKeys("{TAB}") }
        }
    }

    $currentAccountNum++
}
